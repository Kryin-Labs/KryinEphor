# KryinEphor environment variables. Copy to .env for local development.
# Set the same VITE_ variables in Vercel before deploying.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Vercel server-only settings for /api/mcp and /api/oauth. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-project-jwt-secret
MCP_PUBLIC_URL=https://your-kryinephor-domain.example
# PEM-encoded RSA private key, with line breaks escaped as \n in Vercel.
MCP_SIGNING_PRIVATE_KEY=your-rsa-private-key
# Optional Web Push. Generate a VAPID pair; keep the private key in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
